{
  "name": "@hyprnos/dsh-remote-plugin",
  "version": "0.8.23",
  "description": "DSH Remote（个人分支）bundle 插件：手机连接入口、首次连接提示与浏览器管理控制台；内置网关自动启停，支持手机远程会话、审批、文件互传、语音输入和设备管理。",
  "displayName": "DSH Remote",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "gateway.cjs",
    "gateway-stats.cjs",
    "public",
    "apk",
    "cordis.patch.yml",
    "*.md",
    "plugin-center.mjs",
    "plugin-transaction.mjs",
    "market.mjs",
    "insights.mjs",
    "approval-summary.mjs",
    "teams.mjs",
    "task-board.mjs",
    "peak-reminders.mjs",
    "skills.mjs",
    "doctor-skill.mjs",
    "doctor-target.mjs",
    "file-delivery.mjs",
    "skills",
    "session-file.mjs",
    "speech-whisper.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bundle",
    "remote-control",
    "mobile"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hyprnos/dsh-Remote",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyprnos/dsh-Remote.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/hyprnos/dsh-Remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
